[Unit]
Description=SWSTP Edge Gateway — Motion Detection & Telemetry (Raspberry Pi)
Documentation=https://github.com/your-org/swstp_edge
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
# ── Identity ────────────────────────────────────────────────────────────────
# Change 'pi' to the actual user that owns the project directory.
User=pi
Group=pi

# ── Working directory & interpreter ─────────────────────────────────────────
WorkingDirectory=/home/pi/swstp_edge
ExecStart=/usr/bin/python3 /home/pi/swstp_edge/main.py --headless

# ── Environment ──────────────────────────────────────────────────────────────
# Optional: override the backend URL without editing config.py
# Environment=SWSTP_BACKEND_URL=https://solidwasteapi.scipl.info.in
Environment=PYTHONUNBUFFERED=1
Environment=QT_QPA_PLATFORM=offscreen

# ── Restart policy ───────────────────────────────────────────────────────────
# Restart automatically 5 seconds after any failure
Restart=on-failure
RestartSec=5s

# Give the program a full minute to start (sensor + network init can be slow)
TimeoutStartSec=60

# Allow up to 10 quick restarts in 30 seconds before systemd gives up
StartLimitBurst=10
StartLimitIntervalSec=30

# ── Output / logging ─────────────────────────────────────────────────────────
# stdout/stderr go to the systemd journal; read with:
#   sudo journalctl -u swstp-edge -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swstp-edge

# ── Capabilities / security ──────────────────────────────────────────────────
# GPIO access requires the 'gpio' group (or root). If your Pi uses /dev/gpiomem
# ensure the user is in the 'gpio' supplementary group:
#   sudo usermod -aG gpio pi
# If you are using i2c (DS3231 / MPU-6500):
#   sudo usermod -aG i2c pi
SupplementaryGroups=gpio i2c video

[Install]
WantedBy=multi-user.target
